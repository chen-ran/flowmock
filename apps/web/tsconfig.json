{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "rootDirs": [".", "./.react-router/types"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "scripts/**/*.ts",
    ".react-router/types/**/*",
    "react-router.config.ts",
    "stylesheets.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "postcss.config.ts",
    "uno.config.ts"
  ]
}
